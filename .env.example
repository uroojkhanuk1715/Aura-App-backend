# Copy to .env and fill in. Never commit the real file.
NODE_ENV=production
PORT=8080

# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AURA_SECRET=
ADMIN_TOKEN=
PAYMENT_WEBHOOK_SECRET=

# Comma-separated list of your app / website origins
ALLOWED_ORIGINS=https://your-aura-site.example

# Set to 1 only if a reverse proxy in front of this server sets X-Forwarded-For
TRUST_PROXY=0

DB_PATH=./data/aura.db
UPLOAD_DIR=./data/uploads

# VIP is free for now. Set to 0 when you start charging for it.
VIP_FREE=1

# Ads and creators (amounts in paisa, Rs 1 = 100 paisa)
AD_CPM_PAISA=25000
CREATOR_SHARE_PCT=55
MIN_PAYOUT_PAISA=500000

# Moderation: comma-separated words that are not allowed in captions, comments and DMs
BANNED_WORDS=
